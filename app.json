{
  "scripts": {
    "dokku": {
      "predeploy": "set -x; cd src && pushd pretalx/frontend/ && npm ci --include dev && popd && python -m pretalx rebuild"
    }
  },
  "healthchecks": {
    "web": []
  },
  "cron": [
    {
      "command": "env --chdir src python -m pretalx runperiodic",
      "schedule": "*/5 * * * *"
    },
    {
      "command": "env --chdir src python -m pretalx clearsessions",
      "schedule": "@monthly"
    }
  ]
}
